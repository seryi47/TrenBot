# Copia este archivo a .env y rellena tus valores.
# (.env está en .gitignore: NUNCA se sube a GitHub)

# --- Telegram (obligatorio) ---
# Token del bot, te lo da @BotFather con /newbot
TELEGRAM_BOT_TOKEN=
# Tu chat id, te lo dice @userinfobot
TELEGRAM_CHAT_ID=

# --- Cadencias (opcional; por defecto 30 y 10) ---
POLL_INTERVAL=30
ALERT_INTERVAL=10

# --- Avisos en el Mac (opcional) ---
MAC_ALERTS=1
OPEN_BROWSER=1

# --- Vuelos: Amadeus (opcional; alta gratis en developers.amadeus.com) ---
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENV=test
